## 🧩 1. `docs/ARQUITECTURA_GENERAL.dot`

```dot
digraph ArquitecturaGeneral {
  rankdir=LR;
  graph [fontsize=12, labelloc="t", label="Arquitectura General - Sistema EXT2 Simulado"];
  node  [shape=record, fontsize=11];

  subgraph cluster_frontend {
    label="CAPA DE PRESENTACIÓN (React + TS) :3000";
    style=rounded;
    FrontendComponents [label="{Components|• CommandExecutor|• FileSystemList|• ReportViewer|• Terminal}"];
    FrontendServices   [label="{Services|• apiService.ts|• commandParser}"];
    FrontendHooks      [label="{Hooks|• useApi|• useWebSocket|• useNotifications}"];
  }

  subgraph cluster_backend {
    label="CAPA DE APLICACIÓN (Go) :8080";
    style=rounded;
    Controllers [label="{Controllers|/api/commands|/api/script|/api/reports|/api/health}"];
    WS          [label="{WebSocket/SSE|/ws|/api/logs/stream}"];
    CmdDisk     [label="{command/disk|mkdisk|rmdisk|fdisk|mount|mounted}"];
    CmdFS       [label="{command/fs|mkfs|mkdir|mkfile|cat}"];
    CmdUsers    [label="{command/users|login|logout|mkgrp|rmgrp|mkusr|rmusr}"];
    Reports     [label="{command/reports|mbr|disk|inode|block|bm_*|tree|sb|file|ls}"];

    subgraph cluster_hex {
      label="Hexagonal (core / ports / storage)";
      style=dashed;
      CoreModels [label="{core/models|mbr.go|ext2.go|users.go|types.go}"];
      Ports      [label="{core/ports|disk_repository|fs_repository|mount_store|session_store|report_generator}"];
      Storage    [label="{storage|diskio|mounts|session|graphviz}"];
      Utils      [label="{utils|errors|bytes|permissions|calc|smia}"];
    }
  }

  subgraph cluster_data {
    label="CAPA DE DATOS (.mia)";
    style=rounded;
    Disks [label="{/backend/Discos|disco1.mia|disco2.mia|...}"];
  }

  FrontendComponents -> FrontendServices;
  FrontendComponents -> FrontendHooks;
  FrontendServices -> Controllers [label="HTTP REST /api/*"];
  FrontendHooks -> WS [label="WebSocket/SSE"];

  Controllers -> CmdDisk;
  Controllers -> CmdFS;
  Controllers -> CmdUsers;
  Controllers -> Reports;

  CmdDisk -> Ports;
  CmdFS -> Ports;
  CmdUsers -> Ports;
  Reports -> Ports;
  WS -> Utils;

  Ports -> Storage [label="Adapters"];
  Storage -> Disks [label="SafeReadAt / SafeWriteAt", dir=both];
}
```

🔧 **Render:**

```bash
dot -Tpng docs/ARQUITECTURA_GENERAL.dot -o docs/ARQUITECTURA_GENERAL.png
```



## 🧮 2. `docs/FLUJO_MKFS.dot`

```dot
digraph FlujoMKFS {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#f8f8f8", fontsize=11];
  edge [fontsize=10];

  inicio [label="Inicio"];
  validar [label="Validar partición montada (ID)"];
  calcular [label="Calcular estructuras EXT2\nn, bitmaps, tablas, offsets"];
  super [label="Crear Superbloque"];
  bm [label="Inicializar bitmaps (inodos/bloques)"];
  tablas [label="Crear tablas vacías de inodos y bloques"];
  raiz [label="Crear directorio raíz (/)"];
  users [label="Crear users.txt y groups.txt"];
  escribir [label="Escribir estructuras en disco .mia"];
  exito [label="Éxito", shape=doublecircle, fillcolor="#eaffea"];

  inicio -> validar -> calcular -> super -> bm -> tablas -> raiz -> users -> escribir -> exito;
}
```

🖼 **Render:**
`dot -Tpng docs/FLUJO_MKFS.dot -o docs/FLUJO_MKFS.png`



## ⚙️ 3. `docs/FLUJO_FDISK.dot`

```dot
digraph FlujoFDISK {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", fontsize=11];
  edge [fontsize=10];

  leer [label="Leer MBR del disco"];
  validar [label="Validar parámetros\nsize, path, name, type"];
  tipoP [label="type = P\nCrear Partición Primaria"];
  tipoE [label="type = E\nCrear Partición Extendida"];
  tipoL [label="type = L\nBuscar EBR y crear Partición Lógica"];
  actualizar [label="Actualizar MBR/EBR(s) en disco"];
  fin [label="Éxito", shape=doublecircle, fillcolor="#eaffea"];
  error [label="Error: Tipo Inválido", fillcolor="#ffe6e6"];

  leer -> validar;
  validar -> tipoP [label="Primaria"];
  validar -> tipoE [label="Extendida"];
  validar -> tipoL [label="Lógica"];
  validar -> error [label="Otro"];
  tipoP -> actualizar -> fin;
  tipoE -> actualizar -> fin;
  tipoL -> actualizar -> fin;
}
```



## 🧱 4. `docs/ESTADOS_PARTICION.dot`

```dot
digraph EstadosParticion {
  rankdir=LR;
  node [shape=ellipse, style=filled, fillcolor="#f2f2f2", fontsize=11];

  noexist [label="NO EXISTE"];
  creada [label="CREADA"];
  particionada [label="PARTICIONADA"];
  montada [label="MONTADA"];
  formateada [label="FORMATEADA"];

  noexist -> creada [label="mkdisk"];
  creada -> particionada [label="fdisk"];
  particionada -> montada [label="mount"];
  montada -> formateada [label="mkfs"];
  formateada -> particionada [label="unmount"];
  creada -> noexist [label="rmdisk"];
}
```



