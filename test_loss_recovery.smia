# ================================================================
# TEST END-TO-END: LOSS & RECOVERY
# ================================================================
# Este script prueba el ciclo completo de LOSS y RECOVERY en EXT3
#
# Flujo:
# 1. Crear disco y partición
# 2. Formatear como EXT3
# 3. Crear estructura de archivos y directorios
# 4. Modificar permisos
# 5. Ejecutar LOSS (simular pérdida de datos)
# 6. Ejecutar RECOVERY (restaurar desde journal)
# 7. Verificar que la estructura se recuperó
# ================================================================

# ====== FASE 1: SETUP ======
echo "=== FASE 1: Creando disco y partición ==="

mkdisk -size=15 -unit=M -path=Discos/test_recovery.mia
fdisk -size=10 -unit=M -path=Discos/test_recovery.mia -type=P -name=part1

# ====== FASE 2: FORMATEO Y MONTAJE ======
echo "=== FASE 2: Formateando como EXT3 ==="

mount -path=Discos/test_recovery.mia -name=part1
# NOTA: Tomar el ID que devuelve (ej: 841A) y reemplazar en los comandos siguientes

# Formatear como EXT3 (importante para journal)
mkfs -id=841A -fs=3fs -type=full

# ====== FASE 3: LOGIN ======
echo "=== FASE 3: Autenticación ==="

login -id=841A -user=root -pass=123

# ====== FASE 4: CREAR ESTRUCTURA DE ARCHIVOS ======
echo "=== FASE 4: Creando estructura de archivos ==="

# Crear directorios
mkdir -id=841A -path=/docs
mkdir -id=841A -path=/backup
mkdir -id=841A -path=/logs
mkdir -id=841A -path=/config

# Crear subdirectorios
mkdir -id=841A -path=/docs/projects -r
mkdir -id=841A -path=/docs/reports -r
mkdir -id=841A -path=/backup/daily -r

# Crear archivos
mkfile -id=841A -path=/docs/readme.txt -size=50
mkfile -id=841A -path=/docs/projects/plan.txt -size=100
mkfile -id=841A -path=/config/settings.conf -size=30
mkfile -id=841A -path=/logs/app.log -size=200

# ====== FASE 5: MODIFICAR PERMISOS ======
echo "=== FASE 5: Modificando permisos ==="

chmod -id=841A -path=/docs -ugo=755 -r
chmod -id=841A -path=/config -ugo=700
chown -id=841A -path=/logs -usuario=user1

# ====== FASE 6: COPIAR Y MOVER ======
echo "=== FASE 6: Operaciones de copia y movimiento ==="

copy -id=841A -path=/docs/readme.txt -destino=/backup
copy -id=841A -path=/docs/projects -destino=/backup/daily
move -id=841A -path=/config/settings.conf -destino=/backup

# ====== FASE 7: VERIFICAR JOURNAL ======
echo "=== FASE 7: Verificando journal antes de LOSS ==="

# Nota: En el frontend ir a la pestaña Journal para ver las entradas
# O llamar al endpoint GET /api/journal/841A/table

# ====== FASE 8: EJECUTAR LOSS ======
echo "=== FASE 8: Ejecutando LOSS (simulando pérdida de datos) ==="

loss -id=841A

# ====== FASE 9: VERIFICAR QUE LOS DATOS SE PERDIERON ======
echo "=== FASE 9: Verificando pérdida de datos ==="

# Intentar listar directorios (debería estar vacío o fallar)
# cat -id=841A -file=/docs/readme.txt
# (Esto debería fallar porque los datos fueron borrados)

# ====== FASE 10: EJECUTAR RECOVERY ======
echo "=== FASE 10: Ejecutando RECOVERY (restaurando desde journal) ==="

recovery -id=841A

# ====== FASE 11: VERIFICAR RECUPERACIÓN ======
echo "=== FASE 11: Verificando que los datos se recuperaron ==="

# Verificar que los directorios existen
# cat -id=841A -file=/docs/readme.txt
# (Ahora debería funcionar)

# En el frontend, ir a Visualizer y verificar que aparecen:
# - /docs
# - /backup
# - /logs
# - /config
# - Y sus subdirectorios

# ====== FASE 12: OPERACIONES POST-RECOVERY ======
echo "=== FASE 12: Probando operaciones después de recovery ==="

# Crear nuevos archivos para verificar que el filesystem funciona
mkdir -id=841A -path=/post_recovery
mkfile -id=841A -path=/post_recovery/test.txt -size=25

# Modificar archivos existentes
rename -id=841A -path=/docs/readme.txt -name=README.txt

# ====== FIN DEL TEST ======
echo "=== TEST COMPLETADO ==="
echo "Verificar en el Visualizer que:"
echo "1. Los directorios originales fueron recuperados"
echo "2. Los archivos existen (aunque pueden estar vacíos)"
echo "3. Las operaciones post-recovery funcionan"
echo ""
echo "NOTA: EDIT y contenido de archivos no se recuperan"
echo "      porque el journal no guarda snapshots de contenido completo"
