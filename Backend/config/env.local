# Puerto donde corre el servidor HTTP
PORT=8080

# Carpeta donde se guardarán los discos (.mia)
DISKS_PATH=./Backend/Discos

# Carpeta donde se generarán los reportes (Graphviz, bm_inode, etc.)
REPORTS_PATH=./Backend/Reports

# Últimos dos dígitos del carnet (para IDs de mount)
CARNET_LAST_TWO=84

# true = imprime logs detallados (mkdisk, mount, errores)
DEBUG=true
