#  7: CREAR GRUPOS
mkgrp -name=usuarios
mkgrp -name=desarrolladores
mkgrp -name=administradores
# ERROR: Grupo ya existe
mkgrp -name=usuarios
#  8: VER USUARIOS users.txt
cat -file1=/users.txt
#  9: ELIMINAR GRUPO
rmgrp -name=desarrolladores
# Ver cambios
cat -file1=/users.txt
#  10: CREAR USUARIOS
mkusr -user=user1 -pass=pass123 -grp=usuarios
mkusr -user=user2 -pass=pass123 -grp=usuarios
mkusr -user=admin1 -pass=admin123 -grp=administradores
# ERROR: Usuario ya existe
mkusr -user=user1 -pass=pass123 -grp=usuarios
# ERROR: Grupo no existe
mkusr -user=user3 -pass=pass123 -grp=noexiste
# Ver cambios
cat -file1=/users.txt
#  11: CAMBIAR GRUPO DE USUARIO
chgrp -user=user2 -grp=administradores
# Ver cambios
cat -file1=/users.txt
#  12: ELIMINAR USUARIO
rmusr -user=user2
# Ver cambios
cat -file1=/users.txt
#  13: CREAR DIRECTORIOS
mkdir -path=/home
mkdir -path=/home/user1
# ERROR: No existen carpetas padres
mkdir -path=/home/user1/documentos/proyectos/archivos
# Con flag recursivo
mkdir -p -path=/home/user1/documentos/proyectos
mkdir -p -path=/home/archivos/manuales