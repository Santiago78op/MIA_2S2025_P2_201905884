# Test RMUSR - Validación según la guía
# Preparación
mkdisk -size=10 -unit=M -path=/home/julian/test_rmusr.dsk
fdisk -size=5 -unit=M -path=/home/julian/test_rmusr.dsk -type=P -fit=WF -name=Part1
mount -path=/home/julian/test_rmusr.dsk -name=Part1
mkfs -id=A1 -type=full

# Login como root
login -id=A1 -user=root -pass=123

# Crear grupo y usuarios de prueba
mkgrp -id=A1 -name=usuarios

# Crear usuario según ejemplo de la guía
mkusr -id=A1 -user=user1 -pass=usuario -grp=usuarios

# Verificar estado inicial de users.txt (debería tener):
# 1,G,root
# 1,U,root,root,123
# 2,G,usuarios
# 3,U,usuarios,user1,usuario

# Caso 1: Eliminar usuario user1 (ejemplo de la guía)
rmusr -id=A1 -user=user1

# Verificar estado de users.txt después de eliminar (debería quedar):
# 1,G,root
# 1,U,root,root,123
# 2,G,usuarios
# 0,U,usuarios,user1,usuario  ← UID cambiado a 0

# Caso 2: Intentar eliminar user1 nuevamente (debe mostrar error porque ya no existe)
rmusr -id=A1 -user=user1

# Caso 3: Crear más usuarios para pruebas adicionales
mkusr -id=A1 -user=user2 -pass=pass2 -grp=usuarios
mkusr -id=A1 -user=user3 -pass=pass3 -grp=usuarios

# Caso 4: Eliminar usuario que no existe (debe mostrar error)
rmusr -id=A1 -user=noexiste

# Caso 5: Intentar eliminar el usuario root (debe mostrar error)
rmusr -id=A1 -user=root

# Caso 6: Eliminar usuario user2
rmusr -id=A1 -user=user2

# Caso 7: Verificar que usuario eliminado ya no puede hacer login
logout
login -id=A1 -user=user2 -pass=pass2

# Caso 8: Login con usuario activo (user3) debería funcionar
login -id=A1 -user=user3 -pass=pass3

# Caso 9: Usuario no root intenta eliminar (debe mostrar error)
rmusr -id=A1 -user=user2

# Caso 10: Logout y intentar eliminar sin sesión (debe mostrar error)
logout
rmusr -id=A1 -user=user3

# Caso 11: Login como root y eliminar user3
login -id=A1 -user=root -pass=123
rmusr -id=A1 -user=user3

# Caso 12: Crear usuario con mismo nombre que uno eliminado (debería permitirlo)
mkusr -id=A1 -user=user1 -pass=newpass -grp=usuarios

# Verificar que ahora hay dos entradas de user1:
# 0,U,usuarios,user1,usuario    ← usuario eliminado
# 4,U,usuarios,user1,newpass    ← nuevo usuario

# Caso 13: Login con el nuevo user1 (debe funcionar con newpass)
logout
login -id=A1 -user=user1 -pass=newpass

# Caso 14: Intentar login con contraseña antigua (debe fallar)
logout
login -id=A1 -user=user1 -pass=usuario

# Caso 15: Eliminar el nuevo user1
login -id=A1 -user=root -pass=123
rmusr -id=A1 -user=user1

# Ahora debería haber solo una entrada de user1 con ID > 0 marcada como 0

# Caso 16: Parámetro faltante (debe mostrar error)
# rmusr -id=A1 (falta -user)

# Caso 17: Crear múltiples grupos y usuarios, eliminar uno
mkgrp -id=A1 -name=admin
mkgrp -id=A1 -name=dev
mkusr -id=A1 -user=admin1 -pass=admin -grp=admin
mkusr -id=A1 -user=dev1 -pass=dev -grp=dev
mkusr -id=A1 -user=dev2 -pass=dev -grp=dev

# Eliminar admin1
rmusr -id=A1 -user=admin1

# Verificar que dev1 y dev2 siguen activos
logout
login -id=A1 -user=dev1 -pass=dev
logout
login -id=A1 -user=dev2 -pass=dev

# Caso 18: Intentar eliminar usuario eliminado múltiples veces
logout
login -id=A1 -user=root -pass=123
rmusr -id=A1 -user=admin1

# Limpieza
logout
unmount -id=A1
