# PRUEBA GODISK - MIA 2S 2025
#-------------------------------------------*
# 3 Discos - Validación de errores
#-------------------------------------------*
# FASE 1: CREAR DISCOS Y VALIDAR ERRORES
# ERROR: Parámetro incorrecto
mkdisk -param=x -size=30 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoError.mia
# ERROR: Tamaño incorrecto
mkdisk -tamaño=3000 -unit=K -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoError.mia
# Disco A - 25MB
mkdisk -size=25 -unit=M -fit=FF -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia
# Disco B - 30MB
mkdisk -size=30 -unit=M -fit=BF -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoB.mia
# Disco C - 15MB
mkdisk -size=15 -unit=M -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoC.mia
#-------------------------------------------*
# FASE 2: RMDISK - ELIMINAR DISCOS
#-------------------------------------------*
# ERROR: Disco no existe
rmdisk -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoNoExiste.mia
# Crear discos temporales para pruebas de eliminación
mkdisk -size=10 -unit=M -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoTemp1.mia
mkdisk -size=8 -unit=M -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoTemp2.mia
# Eliminar discos temporales
rmdisk -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoTemp1.mia
rmdisk -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoTemp2.mia
# ERROR: Intentar eliminar disco ya eliminado
rmdisk -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoTemp1.mia
#-------------------------------------------*
# FASE 3: FDISK - CREAR PARTICIONES
#-------------------------------------------*
# ERROR: Ruta no encontrada
fdisk -type=P -unit=M -name=PartError -size=10 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoError.mia -fit=BF
# Disco A - 3 particiones primarias
fdisk -type=P -unit=M -name=PartA1 -size=8 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -fit=BF
fdisk -type=P -unit=M -name=PartA2 -size=8 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -fit=BF
fdisk -type=P -unit=M -name=PartA3 -size=8 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -fit=BF
# ERROR: Límite de particiones primarias
fdisk -type=P -unit=M -name=PartError -size=5 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -fit=BF
# Disco B - Partición extendida con lógicas
fdisk -type=E -unit=M -name=PartExtB -size=20 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoB.mia -fit=BF
fdisk -type=L -unit=M -name=PartB1 -size=5 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoB.mia -fit=BF
fdisk -type=L -unit=M -name=PartB2 -size=5 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoB.mia -fit=BF
fdisk -type=L -unit=M -name=PartB3 -size=5 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoB.mia -fit=BF
# Disco C - 2 particiones
fdisk -type=P -unit=M -name=PartC1 -size=8 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoC.mia
fdisk -type=P -unit=M -name=PartC2 -size=6 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoC.mia
# ERROR: Falta espacio
fdisk -type=P -unit=M -name=PartError -size=20 -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoC.mia
#-------------------------------------------*
# FASE 4: MOUNT - MONTAR PARTICIONES
#-------------------------------------------*
# ERROR: Partición no existe
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -name=PartNoExiste
# Montar particiones
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -name=PartA1
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -name=PartA2
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -name=PartA3
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoB.mia -name=PartB1
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoC.mia -name=PartC1
# ERROR: Partición ya montada
mount -path=/home/julian/Documents/MIA_2S2025_P2_201905884/Backend/Discos/DiscoA.mia -name=PartA1
#-------------------------------------------*
# Ver particiones montadas
#-------------------------------------------*
mounted
#Reinicia y Elimina Particiones - unmountall
#-------------------------------------------*
# FASE 5: MKFS - FORMATEAR PARTICIONES
#-------------------------------------------*
# ERROR: ID no encontrado
mkfs -type=full -fs=3fs -id=999X
# Formatear con EXT3 con journaling 
mkfs -type=full -fs=3fs -id=842A
# Formatear con EXT3 con journaling
mkfs -type=full -fs=3fs -id=843A
# Formatear resto con EXT3
mkfs -type=full -fs=3fs -id=841B
mkfs -type=full -fs=3fs -id=841C