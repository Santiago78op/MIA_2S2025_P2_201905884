# Test MKFILE - Validación según la guía
# Preparación
mkdisk -size=10 -unit=M -path=/home/julian/test_mkfile.dsk
fdisk -size=5 -unit=M -path=/home/julian/test_mkfile.dsk -type=P -fit=WF -name=Part1
mount -path=/home/julian/test_mkfile.dsk -name=Part1
mkfs -id=A1 -type=full

# Login como root
login -id=A1 -user=root -pass=123

# Caso 1: Crear archivo con tamaño de 15 bytes (ejemplo de la guía)
# Contenido debería ser: 012345678901234
mkdir -id=A1 -p -path=/home/user/docs
mkfile -id=A1 -size=15 -path=/home/user/docs/a.txt -r

# Caso 2: Crear archivo sin especificar tamaño (debe ser 0 bytes)
mkdir -id=A1 -p -path="/home/mis documentos"
mkfile -id=A1 -path="/home/mis documentos/archivo 1.txt"

# Caso 3: Crear archivo con contenido desde archivo local
# mkfile -id=A1 -path=/home/user/docs/b.txt -r -cont=/home/Documents/b.txt

# Caso 4: Intentar crear archivo que ya existe (debe mostrar error)
mkfile -id=A1 -size=10 -path=/home/user/docs/a.txt

# Caso 5: Crear archivo sin que exista el directorio padre (debe mostrar error)
mkfile -id=A1 -size=20 -path=/noexiste/archivo.txt

# Caso 6: Crear archivo con -r para crear directorios padres
mkfile -id=A1 -size=30 -path=/var/log/app.log -r

# Caso 7: Crear archivo con nombre que incluye espacios
mkfile -id=A1 -size=5 -path="/home/archivo con espacios.txt" -r

# Caso 8: Crear archivo con tamaño negativo (debe mostrar error)
# mkfile -id=A1 -size=-10 -path=/home/error.txt

# Caso 9: Crear archivo con tamaño 0 explícito
mkfile -id=A1 -size=0 -path=/home/vacio.txt -r

# Caso 10: Crear archivo con tamaño grande (múltiples bloques)
# Contenido: 0123456789012345678901234567890123456789012345678901234567890123456789...
mkfile -id=A1 -size=100 -path=/home/grande.txt -r

# Caso 11: Verificar que -cont tiene prioridad sobre -size
# Si se proporciona -cont, se ignora -size
# mkfile -id=A1 -size=999 -path=/home/prioridad.txt -cont=/home/Documents/test.txt -r

# Caso 12: Crear grupo y usuario para pruebas de permisos
mkgrp -id=A1 -name=usuarios
mkusr -id=A1 -user=juan -pass=123 -grp=usuarios

# Caso 13: Root crea archivo (debe tener permisos 664 y UID/GID del usuario)
mkfile -id=A1 -size=10 -path=/root_file.txt -r

# Caso 14: Login como usuario no-root
logout
login -id=A1 -user=juan -pass=123

# Caso 15: Usuario intenta crear archivo en directorio sin permisos
# (debería fallar si no tiene permisos de escritura)
mkfile -id=A1 -size=10 -path=/root_folder/juan_file.txt

# Caso 16: Login como root y crear directorio para usuario
login -id=A1 -user=root -pass=123
mkdir -id=A1 -p -path=/home/juan

# Caso 17: Login como juan y crear archivo en su directorio
logout
login -id=A1 -user=juan -pass=123
mkfile -id=A1 -size=20 -path=/home/juan/miarchivo.txt -r

# Caso 18: Intentar crear sin sesión activa (debe mostrar error)
logout
mkfile -id=A1 -size=10 -path=/test.txt

# Caso 19: Path inválido (debe mostrar error)
login -id=A1 -user=root -pass=123
# mkfile -id=A1 -size=10 -path=

# Caso 20: Parámetro faltante (debe mostrar error)
# mkfile -id=A1 -size=10 (falta -path)

# Caso 21: Crear archivos con diferentes tamaños para ver patrón 0-9
mkfile -id=A1 -size=5 -path=/home/num5.txt -r
# Contenido: 01234

mkfile -id=A1 -size=10 -path=/home/num10.txt -r
# Contenido: 0123456789

mkfile -id=A1 -size=25 -path=/home/num25.txt -r
# Contenido: 0123456789012345678901234

# Caso 22: Crear archivo con punto en el nombre
mkfile -id=A1 -size=15 -path=/home/config.json -r

# Caso 23: Crear archivo en subdirectorio profundo con -r
mkfile -id=A1 -size=50 -path=/a/b/c/d/e/archivo.dat -r

# Caso 24: Verificar contenido de archivo usando cat
cat -id=A1 -file1=/home/num10.txt
# Debería mostrar: 0123456789

cat -id=A1 -file1=/home/num25.txt
# Debería mostrar: 0123456789012345678901234

# Caso 25: Crear archivo con extensión específica
mkfile -id=A1 -size=8 -path=/home/datos.csv -r

# Caso 26: Crear múltiples archivos en el mismo directorio
mkfile -id=A1 -size=3 -path=/home/file1.txt -r
mkfile -id=A1 -size=7 -path=/home/file2.txt -r
mkfile -id=A1 -size=12 -path=/home/file3.txt -r

# Caso 27: Intentar crear archivo con -r=value (debe mostrar error según guía)
# mkfile -id=A1 -size=10 -path=/home/error.txt -r=true

# Limpieza
logout
unmount -id=A1
