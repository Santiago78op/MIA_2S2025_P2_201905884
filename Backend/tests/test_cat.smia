# Test CAT - Validación según la guía
# Preparación
mkdisk -size=10 -unit=M -path=/home/julian/test_cat.dsk
fdisk -size=5 -unit=M -path=/home/julian/test_cat.dsk -type=P -fit=WF -name=Part1
mount -path=/home/julian/test_cat.dsk -name=Part1
mkfs -id=A1 -type=full

# Login como root
login -id=A1 -user=root -pass=123

# Crear estructura de directorios
mkdir -id=A1 -path=/home -r
mkdir -id=A1 -path=/home/user -r
mkdir -id=A1 -path=/home/user/docs -r

# Crear archivos de prueba con contenido
mkfile -id=A1 -path=/home/user/docs/a.txt -size=20 -r
mkfile -id=A1 -path=/home/b.txt -size=14 -r
mkfile -id=A1 -path=/home/c.txt -size=4 -r

# Caso 1: Leer un archivo individual (debería mostrar contenido)
cat -id=A1 -file1=/home/user/docs/a.txt

# Caso 2: Leer múltiples archivos (concatenación)
cat -id=A1 -file1=/home/user/docs/a.txt -file2=/home/b.txt -file3=/home/c.txt

# Caso 3: Intentar leer archivo que no existe (debe mostrar error)
cat -id=A1 -file1=/home/noexiste.txt

# Caso 4: Crear usuario y grupo para pruebas de permisos
mkgrp -id=A1 -name=users
mkusr -id=A1 -user=juan -pass=123 -grp=users

# Crear archivo con permisos específicos
# Permisos: 600 = solo owner puede leer/escribir
mkfile -id=A1 -path=/home/privado.txt -size=10 -r

# Caso 5: Root lee el archivo (debería funcionar)
cat -id=A1 -file1=/home/privado.txt

# Caso 6: Logout como root y login como usuario normal
logout
login -id=A1 -user=juan -pass=123

# Intentar leer archivo sin permisos (debe mostrar error de permisos)
cat -id=A1 -file1=/home/privado.txt

# Caso 7: Intentar leer archivo con permisos adecuados
# Login como root para crear archivo con permisos públicos
logout
login -id=A1 -user=root -pass=123
mkfile -id=A1 -path=/home/publico.txt -size=10 -r

# Login como usuario y leer (debería funcionar si tiene permisos)
logout
login -id=A1 -user=juan -pass=123
cat -id=A1 -file1=/home/publico.txt

# Caso 8: Intentar ejecutar CAT sin sesión activa (debe mostrar error)
logout
cat -id=A1 -file1=/home/publico.txt

# Caso 9: Múltiples archivos donde uno no existe (debe mostrar error)
login -id=A1 -user=root -pass=123
cat -id=A1 -file1=/home/b.txt -file2=/home/noexiste.txt -file3=/home/c.txt

# Caso 10: Intentar leer un directorio en lugar de archivo (debe mostrar error)
cat -id=A1 -file1=/home/user

# Caso 11: Parámetro faltante (debe mostrar error)
# cat -id=A1 (sin -file)

# Caso 12: Path inválido
cat -id=A1 -file1=

# Caso 13: Leer archivo en ruta absoluta completa
cat -id=A1 -file1=/home/user/docs/a.txt

# Limpieza
logout
unmount -id=A1
