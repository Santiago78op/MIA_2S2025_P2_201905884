# Test MKDIR - Validación según la guía
# Preparación
mkdisk -size=10 -unit=M -path=/home/julian/test_mkdir.dsk
fdisk -size=5 -unit=M -path=/home/julian/test_mkdir.dsk -type=P -fit=WF -name=Part1
mount -path=/home/julian/test_mkdir.dsk -name=Part1
mkfs -id=A1 -type=full

# Login como root
login -id=A1 -user=root -pass=123

# Caso 1: Crear carpeta simple (ejemplo de la guía)
mkdir -id=A1 -path=/home

# Caso 2: Intentar crear carpeta sin que exista el padre (debe mostrar error)
mkdir -id=A1 -path=/home/user/docs/usac

# Caso 3: Crear carpeta con -p para crear padres (ejemplo de la guía)
mkdir -id=A1 -p -path=/home/user/docs/usac

# Caso 4: Crear carpeta con espacios en el nombre (ejemplo de la guía)
mkdir -id=A1 -path="/home/mis documentos"
mkdir -id=A1 -path="/home/mis documentos/archivos clases"

# Caso 5: Intentar crear directorio que ya existe (debe mostrar error)
mkdir -id=A1 -path=/home

# Caso 6: Crear directorio ya existente con -p (no debe mostrar error según guía)
mkdir -id=A1 -p -path=/home

# Caso 7: Crear estructura compleja con -p
mkdir -id=A1 -p -path=/var/log/system/app

# Caso 8: Crear múltiples carpetas en diferentes ubicaciones
mkdir -id=A1 -path=/tmp
mkdir -id=A1 -path=/etc
mkdir -id=A1 -path=/opt

# Caso 9: Crear carpeta con nombre de 1 carácter
mkdir -id=A1 -path=/a

# Caso 10: Crear carpeta con nombre largo
mkdir -id=A1 -path=/carpeta_con_nombre_muy_largo_pero_valido

# Caso 11: Intentar crear en ruta que no es directorio (crear archivo primero)
mkfile -id=A1 -path=/archivo.txt -size=10 -r
# Esto debería fallar porque /archivo.txt no es directorio
# mkdir -id=A1 -path=/archivo.txt/subcarpeta

# Caso 12: Crear grupo y usuario para pruebas de permisos
mkgrp -id=A1 -name=usuarios
mkusr -id=A1 -user=juan -pass=123 -grp=usuarios

# Caso 13: Root crea carpeta (debe tener permisos 664 según guía)
mkdir -id=A1 -path=/root_folder

# Caso 14: Login como usuario no-root
logout
login -id=A1 -user=juan -pass=123

# Caso 15: Usuario no-root intenta crear carpeta en raíz
# (debería fallar si no tiene permisos de escritura en /)
mkdir -id=A1 -path=/juan_folder

# Caso 16: Login como root y crear carpeta para usuario
login -id=A1 -user=root -pass=123
mkdir -id=A1 -p -path=/home/juan

# Caso 17: Login como juan y crear carpeta en su directorio
# (debería funcionar si tiene permisos de escritura)
logout
login -id=A1 -user=juan -pass=123
mkdir -id=A1 -path=/home/juan/documentos

# Caso 18: Intentar crear sin sesión activa (debe mostrar error)
logout
mkdir -id=A1 -path=/test

# Caso 19: Path inválido (debe mostrar error)
login -id=A1 -user=root -pass=123
# mkdir -id=A1 -path=

# Caso 20: Parámetro faltante (debe mostrar error)
# mkdir -id=A1 (falta -path)

# Caso 21: Crear estructura anidada compleja con -p
mkdir -id=A1 -p -path=/a/b/c/d/e/f/g

# Caso 22: Verificar que -p no recibe valor (según guía)
# Si recibe valor debe mostrar error
# mkdir -id=A1 -p=true -path=/test_error

# Caso 23: Crear directorio con punto en el nombre
mkdir -id=A1 -path="/home/archivo.backup"

# Caso 24: Crear directorios con diferentes niveles
mkdir -id=A1 -p -path=/nivel1
mkdir -id=A1 -p -path=/nivel1/nivel2
mkdir -id=A1 -p -path=/nivel1/nivel2/nivel3

# Limpieza
logout
unmount -id=A1
