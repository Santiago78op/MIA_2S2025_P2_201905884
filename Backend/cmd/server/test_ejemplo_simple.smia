# Script de ejemplo simple
# Este script demuestra operaciones básicas del sistema MIA

# 1. CREAR DISCO
# Crea un disco de 10MB
mkdisk -size=10 -unit=M -path=./Discos/EjemploSimple.mia

# 2. CREAR PARTICIÓN
# Crea una partición primaria de 5MB
fdisk -size=5 -unit=M -path=./Discos/EjemploSimple.mia -type=P -fit=BF -name=MiParticion

# 3. MONTAR PARTICIÓN
# Monta la partición (se le asigna ID automáticamente, ej: 841A)
mount -path=./Discos/EjemploSimple.mia -name=MiParticion

# 4. FORMATEAR
# Formatea la partición con filesystem EXT2
mkfs -type=full -id=841A

# 5. LOGIN
# Inicia sesión como usuario root (password por defecto: 123)
login -user=root -pass=123 -id=841A

# 6. CREAR DIRECTORIO
# Crea un directorio en la raíz
mkdir -path=/documentos -id=841A

# 7. CREAR ARCHIVO VACÍO
# Crea un archivo de 50 bytes vacío
mkfile -path=/documentos/readme.txt -id=841A -size=50

# 8. CREAR ARCHIVO CON CONTENIDO
# Crea un archivo con el contenido de NAME.txt
mkfile -path=/documentos/nombre.txt -id=841A -cont=./CONT/NAME.txt

# 9. LEER ARCHIVO
# Lee el contenido del archivo
cat -file=/documentos/nombre.txt -id=841A

# 10. GENERAR REPORTES
# Reporte MBR (información de particiones)
rep -name=mbr -path=./Discos/EjemploSimple.mia -id=841A -ruta=./Reports/ejemplo_mbr.txt

# Reporte de disco gráfico
rep -name=disk -path=./Discos/EjemploSimple.mia -id=841A -ruta=./Reports/ejemplo_disk.jpg

# Reporte de árbol de directorios
rep -name=tree -path=./Discos/EjemploSimple.mia -id=841A -ruta=./Reports/ejemplo_tree.png

# Reporte de bitmap de inodos
rep -name=bm_inode -path=./Discos/EjemploSimple.mia -id=841A -ruta=./Reports/ejemplo_bm_inode.txt

# Reporte de superbloque
rep -name=sb -path=./Discos/EjemploSimple.mia -id=841A -ruta=./Reports/ejemplo_sb.txt

# 11. LOGOUT
logout

# 12. DESMONTAR
umount -id=841A

# FIN DEL SCRIPT
# Los archivos generados estarán en:
# - Disco: ./Discos/EjemploSimple.mia
# - Reportes: ./Reports/ejemplo_*.{txt,jpg,png}
